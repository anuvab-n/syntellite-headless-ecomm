# ── Core ────────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=local
PORT=8000

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgres://ecom:ecom@localhost:55432/ecom
# DATABASE_REPLICA_URL is optional locally; REQUIRED in production (config.ts refuses to boot without it).
# DATABASE_REPLICA_URL=postgres://ecom:ecom@localhost:55432/ecom
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ── Redis ───────────────────────────────────────────────
# Three SEPARATE logical databases, by design:
#   /0 cache  → allkeys-lru   (evictable; losing a key costs a query)
#   /1 locks  → noeviction    (idempotency keys + rate limits; an eviction here loses money)
#   /2 queue  → BullMQ        (an eviction here drops jobs)
# `/1 locks` is the only one every request path touches (rate limiting). `/2 queue` is still
# a required value — config.ts validates it — but nothing reads from it by default: the outbox
# now defaults to the 'in-process' transport (the worker process runs handlers itself; see
# `container.ts`), so no BullMQ job is ever enqueued unless a deployment opts back into the
# 'queue' transport explicitly. Point it at the same Redis; there is nothing to provision for it.
REDIS_CACHE_URL=redis://localhost:56379/0
REDIS_LOCK_URL=redis://localhost:56379/1
REDIS_QUEUE_URL=redis://localhost:56379/2

# ── Auth ────────────────────────────────────────────────
# RS256 keypair. Generate with: pnpm keys:generate
# Rotating these invalidates every access token in flight (refresh sessions survive — they live in Postgres).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=ecom-local
JWT_AUDIENCE=ecom-storefront
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ── CORS ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Payments (sandbox) ──────────────────────────────────
PAYMENT_SANDBOX_MODE=true

# Increment 36 — online payment expiry. Window is stamped at initiation, so a change
# here affects only new payments. COD is out of scope and keeps expires_at NULL.
PAYMENT_EXPIRY_MINUTES=30
# How often the leader-elected sweeper runs. Bounds how long stock stays held past the window.
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=60000
# Candidates claimed per pass. Bounded because each takes an order and a payment row lock.
PAYMENT_EXPIRY_SWEEP_BATCH_SIZE=100
# Razorpay — PROVIDER-SUPPLIED, all three or none. The container builds the real gateway
# only when every one is present; otherwise online payment answers 503 and COD still works.
# The webhook secret is DISTINCT from the API secret — reusing one for the other is a real,
# common bug. Live keys come from the company's Razorpay account, never from this file.
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=xxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxx

# ── Storage (MinIO locally) ─────────────────────────────
S3_BUCKET=ecom-media
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Email (MailHog locally) ─────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
# Credentials — PROVIDER-SUPPLIED. Leave BOTH unset locally: MailHog accepts mail from
# anyone, and half a pair is ignored on purpose (a user with no password would make the
# client attempt AUTH and fail every send).
# In production these are mandatory in practice — SES, SendGrid and Postmark all refuse to
# relay without AUTH — even though config.ts does not force them, because an authenticated
# in-cluster smarthost is also a valid topology.
# SMTP_USER=
# SMTP_PASS=
# Implicit TLS from the first byte (SMTPS, usually port 465). Leave false for port 587 and
# for MailHog: the connection then starts in the clear and upgrades via STARTTLS.
SMTP_SECURE=false
# The From header on every message, and where a password-reset link points. Both have
# localhost defaults in config.ts, so set them before this serves real customers — the
# reset link is emailed verbatim. STOREFRONT-SPECIFIC: the reset URL must point at your
# own front end, not at this API.
MAIL_FROM=no-reply@localhost
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password

# ── Behaviour ───────────────────────────────────────────
DEFAULT_CURRENCY=INR
# The store every request resolves to while the platform is single-store.
# Must match a row created by `pnpm db:seed`.
DEFAULT_STORE_SLUG=default

# Authentication rate limits. Calibrated in Phase 8 load testing; generous for a human,
# far too tight for a script. IP counts every attempt, email counts failures only.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_IP_MAX=10
AUTH_RATE_LIMIT_EMAIL_MAX=5
# Refresh is a scheduled background call, not a human action — one NAT gateway
# legitimately produces far more refreshes than logins, so this is much higher.
AUTH_RATE_LIMIT_REFRESH_IP_MAX=60

RESERVATION_TTL_MINUTES=15
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# ── Observability ───────────────────────────────────────
LOG_LEVEL=debug
# LOG_FORMAT must be "json" in production — config.ts refuses to boot otherwise.
LOG_FORMAT=pretty
# COMPANY-SUPPLIED, and REQUIRED in production: config.ts refuses to boot without it.
# SENTRY_DSN=
